{
  "manifest_version": 3,
  "name": "BREAKEX - Pause. Refresh. Continue.",
  "short_name": "BREAKEX",
  "version": "1.1.0",
  "description": "Gentle on-screen reminders to take screen breaks, drink water, and build healthier habits — fully customizable with your own timers and animations.",
  "permissions": ["storage", "alarms", "scripting", "tabs", "unlimitedStorage", "notifications"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "BREAKEX",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [{
    "resources": ["assets/*"],
    "matches": ["<all_urls>"]
  }],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
